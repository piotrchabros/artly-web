{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artly-web",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // No routes: since 2026-11-26 artly.com.pl and staging.artly.com.pl are
  // served by the Payload app (artly-payload) on the VPS. A custom-domain route
  // here would re-claim the hostname from DNS on the next `wrangler deploy`.
  // To roll back, re-add { "pattern": "artly.com.pl", "custom_domain": true }
  // (+ www) after removing the A records in Cloudflare.
  "env": {
    // Staging: same build, own Worker, never indexed (see worker/index.js).
    "staging": {
      "name": "artly-web-staging"
    }
  }
}
