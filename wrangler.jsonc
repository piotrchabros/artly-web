{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artly-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "artly.com.pl", "custom_domain": true },
    { "pattern": "www.artly.com.pl", "custom_domain": true }
  ]
}
