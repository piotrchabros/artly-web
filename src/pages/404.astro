---
import Base from '../layouts/Base.astro';
import { getDict, localePath } from '../i18n';

const d = getDict('pl');
---

<Base locale="pl" page="404" noindex title={`${d.notFound.title} — ARTLY`} description={d.notFound.text}>
  <section class="nf">
    <h1 class="h2">{d.notFound.title}</h1>
    <p class="lead nf__text">{d.notFound.text}</p>
    <a class="btn btn--dark" href={localePath('pl')}>{d.notFound.back}</a>
  </section>
</Base>

<style>
  .nf { max-width: 720px; margin-inline: auto; padding: 120px 24px 140px; text-align: center; }
  .nf__text { margin: 20px 0 36px; }
</style>
