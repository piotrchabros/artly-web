---
import ComingSoon from '../../components/pages/ComingSoon.astro';
import { LOCALES, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'pl').map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<ComingSoon locale={locale} page="kontakt" />
