---
import '@fontsource/italiana/400.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import newsreaderUrl from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import { ClientRouter } from 'astro:transitions';
import AppBanner from '../components/site/AppBanner.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { APP_STORE_ID } from '../data/site';
import { LOCALES, LOCALE_META, DEFAULT_LOCALE, alternates, localePath, pagePath, useT, type Locale, type PageKey } from '../i18n';

interface Crumb { name: string; path: string }
interface Props {
  locale: Locale;
  /** Localized page (gets hreflang alternates for every locale). */
  page?: PageKey;
  /** Path of a page that exists in one language only, e.g. "/inspiracje/". */
  path?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumbs after "home"; rendered as BreadcrumbList JSON-LD. */
  crumbs?: Crumb[];
}

const { locale, page, noindex = false, ogType = 'website', jsonLd = [], crumbs } = Astro.props;
const t = useT(locale);
const title = Astro.props.title ?? t('meta.title');
const description = Astro.props.description ?? t('meta.description');

const site = Astro.site ?? Astro.url;
const abs = (p: string) => new URL(p, site).href;
const indexable = page !== '404' && !noindex;
const ownPath = page ? localePath(locale, pagePath(page)) : (Astro.props.path ?? Astro.url.pathname);
const canonical = abs(ownPath);
const alts = page ? alternates(pagePath(page)).map((a) => ({ ...a, href: abs(a.href) })) : [];
const xDefault = page ? abs(localePath(DEFAULT_LOCALE, pagePath(page))) : canonical;
const ogImage = abs(Astro.props.ogImage ?? '/og-default.png');

const breadcrumb = crumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'ARTLY', path: localePath(locale) }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.path),
  })),
};
const ld = [...jsonLd, ...(breadcrumb ? [breadcrumb] : [])];
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      // Decide before first paint whether the app banner shows (CLS = 0). Re-run after ClientRouter swaps.
      (window.__artlyAppban = function () {
        var d = document.documentElement, ua = navigator.userAgent, hide = false;
        try { hide = Date.now() < +(localStorage.getItem('artly_appban_until') || 0); } catch (e) {}
        var iosSafari = /iP(hone|od|ad)/.test(ua) && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua);
        var mobile = matchMedia('(max-width: 1023px) and (pointer: coarse)').matches;
        var path = location.pathname.replace(/^\/(en|de|fr|es|it|nl)(?=\/)/, '');
        d.classList.toggle('no-appban', !!(hide || iosSafari || !mobile || /ArtlyApp/.test(ua) || /^\/(aplikacja|koszyk|checkout)/.test(path)));
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    {indexable && <link rel="canonical" href={canonical} />}
    {indexable && alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {indexable && alts.length > 0 && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ARTLY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
    {page && LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#FFFFFF" />
    {/* iOS Safari shows Apple's native Smart App Banner instead of ours (spec §6.0). */}
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}, app-argument=${canonical}`} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <ClientRouter />
  </head>
  <body data-testid="screen-root">
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <AppBanner locale={locale} />
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} page={page} />
    <script>
      import '../scripts/init';
    </script>
  </body>
</html>
