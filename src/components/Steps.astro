---
import ScreenRotator from './ScreenRotator.astro';
import { shot, type ScreenKey } from '../data/screens';
import { getDict, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
const keys: ScreenKey[] = ['wnetrze', 'gust', 'wizualizacja', 'zakup'];
const shots = keys.map((k) => shot(k, d.screens[k]));
---

<section id="jak-to-dziala" class="section section--white steps" aria-labelledby="steps-title" data-stepper>
  <div class="container steps__grid">
    <div class="steps__main">
      <div class="reveal">
        <p class="overline">{d.steps.overline}</p>
        <h2 id="steps-title" class="h2 steps__title">{d.steps.title}</h2>
      </div>

      <div role="tablist" aria-orientation="vertical" aria-label={d.steps.label} class="steps__list reveal">
        {d.steps.items.map((step, i) => (
          <button
            type="button"
            role="tab"
            id={`st-tab-${i}`}
            aria-controls={`st-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="step"
          >
            <span class="step__num" aria-hidden="true">{i + 1}</span>
            <span class="step__body">
              <span class="step__title">{step.title}</span>
              <span class="step__text">{step.text}</span>
              <span class="step__track" aria-hidden="true"><span class:list={['bar', { 'is-full': i === 0 }]}></span></span>
              <span class="step__short">{i + 1}. {step.short}</span>
            </span>
          </button>
        ))}
      </div>
    </div>

    <div class="steps__card reveal">
      <ScreenRotator
        id="steps-rotator"
        shots={shots}
        width={308}
        mobileWidth={244}
        autoplay={false}
        dots={false}
        widths={[300, 600]}
        sizes="(max-width: 767px) 230px, 290px"
        label={d.steps.label}
      />
    </div>

    <div class="steps__panels only-mobile">
      {d.steps.items.map((step, i) => (
        <div role="tabpanel" id={`st-panel-${i}`} aria-labelledby={`st-tab-${i}`} hidden={i > 0}>
          <h3 class="steps__panel-title">{step.title}</h3>
          <p class="steps__panel-text">{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps__grid { display: grid; grid-template-columns: 1fr 436px; gap: 104px; align-items: center; }
  .steps__title { max-width: 600px; margin-top: 14px; }

  .steps__list { display: flex; flex-direction: column; gap: 8px; margin-top: 40px; }

  .step {
    display: flex; gap: 22px; width: 100%; padding: 20px 22px;
    text-align: left; background: transparent; border: 1px solid transparent; border-radius: 20px; cursor: pointer;
    transition: transform var(--d-base) var(--ease-out), background var(--d-base) var(--ease-out), border-color var(--d-base) var(--ease-out);
  }
  .step[aria-selected='true'] { background: var(--bg); border-color: var(--border-soft); transform: translateX(6px); }

  .step__num {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    font: 400 20px/1 var(--font-serif); background: var(--sand); color: var(--accent-text);
    transition: background var(--d-base) ease, color var(--d-base) ease;
  }
  .step[aria-selected='true'] .step__num { background: var(--ink); color: var(--bg); }

  .step__body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .step__title { font: 400 23px/1.2 var(--font-serif); color: var(--ink); }
  .step__text { margin-top: 4px; font-size: 15px; line-height: 1.5; color: var(--subtle); }
  .step__track { display: block; height: 2px; margin-top: 18px; background: var(--divider); overflow: hidden; }
  .step__track .bar { display: block; width: 100%; height: 100%; background: var(--accent); }
  .step__short { display: none; }

  .steps__card { width: 436px; padding: 48px 0; border-radius: var(--r-card-lg); background: var(--blue); display: flex; justify-content: center; }

  .steps__panel-title { margin-top: 28px; font: 400 26px/1.15 var(--font-serif); color: var(--ink); }
  .steps__panel-text { margin-top: 8px; font-size: 16px; line-height: 1.55; color: var(--subtle); }

  @media (max-width: 1199px) {
    .steps__grid { grid-template-columns: 1fr; gap: 56px; }
    .steps__card { justify-self: center; }
  }

  @media (max-width: 767px) {
    .steps__grid { gap: 0; }
    .steps__list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 28px; }

    .step { display: block; min-height: 44px; padding: 0; border: 0; border-radius: 0; transform: none; }
    .step[aria-selected='true'] { background: none; transform: none; }
    .step__num, .step__title, .step__text { display: none; }
    .step__track { height: 4px; margin-top: 0; border-radius: 2px; }
    .step.is-done .bar { transform: scaleX(1); }
    .step__short { display: block; margin-top: 14px; font-size: 15px; line-height: 1.3; color: var(--subtle); }
    .step[aria-selected='true'] .step__short { font-weight: 600; color: var(--ink); }

    .steps__card { width: auto; margin: 40px 13px 0; padding: 32px 0; justify-self: stretch; }
  }
</style>
