---
import Logo from './ui/Logo.astro';
import { localePath, useT, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
---

<div class="sticky-cta only-mobile" role="region" aria-label={t('sticky.text')}>
  <Logo size={26} tone="light" />
  <p class="sticky-cta__text">{t('sticky.text')}</p>
  <a class="btn btn--accent sticky-cta__btn" href={localePath(locale, '', 'pobierz')}>{t('sticky.button')}</a>
</div>

<style>
  .sticky-cta {
    position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 40;
    height: 64px; border-radius: var(--r-pill);
    background: rgba(27,37,48,.94); box-shadow: 0 18px 40px rgba(27,37,48,.28);
    display: flex; align-items: center; gap: 14px; padding: 0 8px 0 18px;
    transform: translateY(140%); transition: transform 600ms var(--ease-out);
  }
  .sticky-cta.is-visible { transform: none; }
  .sticky-cta__text {
    flex: 1; min-width: 0; font-size: 14px; line-height: 1.3; color: var(--on-dark-muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .sticky-cta__btn { flex: none; height: 48px; padding: 0 24px; font-weight: 600; font-size: 16px; }
  @media (min-width: 768px) { .sticky-cta { display: none; } }
  @media (prefers-reduced-motion: reduce) { .sticky-cta { transition: none; } }
</style>
