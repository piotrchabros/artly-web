---
import Phone from './ui/Phone.astro';

const features = [
  {
    title: 'Zdjęcie wystarczy',
    text: 'Dodaj zdjęcie obrazu, a aplikacja sama rozpozna styl, kolorystykę i motywy — Ty tylko sprawdzasz i poprawiasz.',
  },
  {
    title: 'Twoja historia',
    text: 'Profil z opowieścią o Tobie i Twojej pracowni. Opisy piszesz sam — możesz poprosić o pomoc w redakcji.',
  },
  {
    title: 'Sprzedaż i zamówienia',
    text: 'Sprzedawaj gotowe prace i przyjmuj zlecenia na wymiar. Wszystkie zadania widzisz w jednym panelu.',
  },
  {
    title: 'Przejrzyste wypłaty',
    text: 'Widzisz, ile zarobiłeś i ile jest w drodze. Wypłacasz środki, kiedy chcesz, albo automatycznie co tydzień.',
  },
];

const screens = [
  {
    src: '/assets/de88edb7d4ae6d99e058e7e03542aaa5.png',
    alt: 'Dodawanie prac z automatyczną analizą zdjęcia',
    caption: 'Dodaj prace',
    margin: '0',
  },
  {
    src: '/assets/0a529a016eb32d9f966a881c124c256e.png',
    alt: 'Opis dzieła ze stylem, kolorami i tagami rozpoznanymi automatycznie',
    caption: 'Sprawdź styl, kolory i tagi',
    margin: '48px 0 0',
  },
  {
    src: '/assets/17156d667336a6ad5df55093439da4e8.png',
    alt: 'Panel artysty z saldem i zadaniami',
    caption: 'Prowadź sprzedaż',
    margin: '0',
  },
  {
    src: '/assets/cc83aaa39364cde076c7ad6cd78dcb1e.png',
    alt: 'Wypłaty środków',
    caption: 'Wypłacaj środki',
    margin: '48px 0 0',
  },
];
---

<section id="dla-artystow" style="background: #1B2530; color: #F7F4EF; padding: 112px 24px">
  <div style="max-width: 1200px; margin: 0 auto">
    <div style="display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; justify-content: space-between">
      <div style="flex: 1 1 520px; min-width: 0">
        <div style="font-size: 12px; letter-spacing: 0.24em; font-weight: 600; color: #F2C3A1">DLA ARTYSTÓW</div>
        <h2 style="margin: 14px 0 18px; font-family: 'Newsreader', serif; font-weight: 400; font-size: clamp(34px, 4vw, 54px); line-height: 1.06">Twoja sztuka znajdzie swoje miejsce.</h2>
        <p style="margin: 0; max-width: 560px; font-size: 18px; line-height: 1.6; color: #C9D2DA">Pokazujemy Twoje prace osobom, do których wnętrz naprawdę pasują. Ty tworzysz — resztę ułatwiamy.</p>
      </div>
      <a href="#pobierz" style="display: inline-flex; align-items: center; height: 56px; padding: 0 28px; border-radius: 999px; background: #D2885A; color: #1B2530; text-decoration: none; font-size: 16px; font-weight: 600">Dołącz jako artysta</a>
    </div>

    <div style="margin-top: 64px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px">
      {features.map((feature) => (
        <div>
          <div style="font-family: 'Newsreader', serif; font-size: 24px; color: #F2C3A1">✦</div>
          <h3 style="margin: 12px 0 8px; font-family: 'Newsreader', serif; font-weight: 400; font-size: 24px">{feature.title}</h3>
          <p style="margin: 0; font-size: 15px; line-height: 1.55; color: #C9D2DA">{feature.text}</p>
        </div>
      ))}
    </div>

    <div style="margin-top: 72px; display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: 32px">
      {screens.map((screen) => (
        <figure style={`margin: ${screen.margin}; display: flex; flex-direction: column; align-items: center; gap: 16px`}>
          <Phone src={screen.src} alt={screen.alt} width={240} style="border-color: #0F161D" />
          <figcaption style="font-size: 14px; color: #C9D2DA">{screen.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
