---
import Phone from './ui/Phone.astro';

const steps = [
  {
    src: '/assets/0e5f65337539070fced78dc8710ffa2c.png',
    alt: 'Krok 1: dodawanie zdjęcia wnętrza',
    title: 'Pokaż wnętrze',
    text: 'Zrób zdjęcie ściany salonu, sypialni lub biura.',
  },
  {
    src: '/assets/64cf61f5b83774e745f1208f2f2163fa.png',
    alt: 'Krok 2: wybór stylu, kolorystyki, formatu i budżetu',
    title: 'Określ gust',
    text: 'Wybierz styl, kolorystykę, format i budżet.',
  },
  {
    src: '/assets/33a48acf66d17e9c2186e7562ad52738.png',
    alt: 'Krok 3: obraz na zdjęciu ściany',
    title: 'Zobacz efekt',
    text: 'Porównaj dopasowane dzieła na swojej ścianie.',
  },
  {
    src: '/assets/97104a3fd43b0b569d9a2793d00cca91.png',
    alt: 'Krok 4: potwierdzenie zakupu',
    title: 'Kup lub zamów',
    text: 'Kup gotową pracę albo zleć realizację artyście.',
  },
];
---

<section id="jak-to-dziala" style="padding: 104px 24px">
  <div style="max-width: 1200px; margin: 0 auto">
    <div style="text-align: center">
      <div style="font-size: 12px; letter-spacing: 0.24em; font-weight: 600; color: #9E522A">JAK TO DZIAŁA</div>
      <h2 style="margin: 14px 0 0; font-family: 'Newsreader', serif; font-weight: 400; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.1">Cztery kroki do własnego dzieła</h2>
    </div>
    <div style="margin-top: 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px">
      {steps.map((step, i) => (
        <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px">
          <Phone src={step.src} alt={step.alt} width={220} />
          <div style="font-family: 'Newsreader', serif; font-size: 34px; color: #D2885A">{i + 1}</div>
          <h3 style="margin: -8px 0 0; font-family: 'Newsreader', serif; font-weight: 400; font-size: 24px">{step.title}</h3>
          <p style="margin: 0; max-width: 250px; font-size: 15px; line-height: 1.5; color: #4A5560">{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
