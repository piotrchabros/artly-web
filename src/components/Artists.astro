---
import { getDict, localePath, type Locale } from '../i18n';
import { shot, type ScreenKey } from '../data/screens';
import Carousel from './Carousel.astro';
import Phone from './ui/Phone.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);

const keys: ScreenKey[] = ['dodajPrace', 'opisDziela', 'panel', 'wyplaty'];
const items = d.artists.items.map((item, i) => ({ ...item, shot: shot(keys[i], d.screens[keys[i]]) }));
const joinHref = localePath(locale, 'kontakt');
---

<section id="dla-artystow" class="section section--ink artists" aria-labelledby="artists-title">
  <div class="container">
    <div class="artists__head reveal">
      <div class="artists__intro">
        <p class="overline overline--light">{d.artists.overline}</p>
        <h2 id="artists-title" class="h2 artists__title">{d.artists.title}</h2>
        <p class="artists__text">{d.artists.text}</p>
      </div>
      <a class="btn btn--accent only-desktop" href={joinHref}>{d.artists.cta}</a>
    </div>

    <Carousel
      id="artists-carousel"
      locale={locale}
      count={items.length}
      item="220px"
      gap="16px"
      pad="85px"
      align="center"
      scale
      dark
      class="artists__row"
      label={d.artists.label}
    >
      {items.map((item) => (
        <li class="artist">
          <Phone
            width={254}
            mobileWidth={220}
            shot={item.shot}
            loading="lazy"
            widths={[240, 480]}
            sizes="(max-width: 767px) 206px, 236px"
          />
          <p class="artist__label only-desktop">{item.label}</p>
          <div class="artist__cap only-mobile">
            <h3>{item.title}</h3>
            <p>{item.short}</p>
          </div>
        </li>
      ))}
    </Carousel>

    <a class="btn btn--accent btn--block only-mobile artists__cta-m" href={joinHref}>{d.artists.cta}</a>

    <ul class="artists__benefits only-desktop" data-stagger>
      {items.map((item) => (
        <li class="benefit reveal">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .artists { padding-block: 128px 120px; }

  .artists__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }
  .artists__intro { max-width: 900px; }
  .artists__title { color: var(--bg); margin-top: 14px; }
  .artists__text { font-size: 17px; line-height: 1.6; color: var(--on-dark-muted); max-width: 520px; margin-top: 24px; }
  .artists__head .btn { flex: none; }

  .artist { list-style: none; }
  .artist__label { font-size: 14px; color: var(--on-dark-muted); text-align: center; margin-top: 24px; }
  .artist__cap { text-align: center; }
  .artist__cap h3 { font: 400 26px/1.15 var(--font-serif); color: var(--bg); margin-top: 28px; }
  .artist__cap p { font-size: 16px; line-height: 1.5; color: var(--on-dark-muted); margin-top: 6px; }

  .artists__benefits { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin-top: 72px; }
  .benefit h3 { font: 400 23px/1.2 var(--font-serif); color: var(--bg); }
  .benefit p { font-size: 15px; line-height: 1.6; color: var(--on-dark-muted); margin-top: 10px; }

  /* The list element is rendered by Carousel, so reach it through :global under this section. */
  @media (min-width: 768px) {
    .artists :global(.artists__row) {
      list-style: none; padding: 0;
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 48px 28px; justify-items: center; margin-top: 72px;
    }
  }

  @media (min-width: 1200px) {
    .artists :global(.artists__row) { grid-template-columns: repeat(4, 1fr); gap: 28px; align-items: start; }
    .artist { transform-origin: 50% 100%; transition: transform 600ms var(--ease-out); }
    .artist:nth-child(2), .artist:nth-child(4) { margin-top: 48px; }
  }

  /* A14: fan out the phones when the row is hovered */
  @media (hover: hover) and (min-width: 1200px) {
    .artists :global(.artists__row:hover) .artist:nth-child(1) { transform: translateX(-30px) rotate(-6deg); }
    .artists :global(.artists__row:hover) .artist:nth-child(2),
    .artists :global(.artists__row:hover) .artist:nth-child(3) { transform: translateY(-16px); }
    .artists :global(.artists__row:hover) .artist:nth-child(4) { transform: translateX(30px) rotate(6deg); }
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .artists__head { flex-wrap: wrap; }
    .artists__benefits { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767px) {
    .artists { padding-block: 72px; }
    .artists__head { display: block; }
    .artists :global(.artists__row) { margin-top: 48px; margin-inline: calc(-1 * var(--gutter)); }
    .artists__cta-m { margin-top: 36px; }
  }
</style>
