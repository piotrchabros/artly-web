---
import { getDict, greetings, LOCALES, LOCALE_META, type Locale } from '../i18n';
import Icon from './ui/Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
const words = greetings(locale);
---

<section id="lokalnie" class="section local">
  <div class="container">
    <div class="local__grid" data-stagger>
      <article class="local__card local__nearby reveal">
        <Icon name="pin" size={30} />
        <h3 class="local__h3">{d.local.nearby.title}</h3>
        <p class="local__text">{d.local.nearby.text}</p>
        <div class="local__thumbs" aria-hidden="true">
          <div class="local__thumb local__thumb--a float"><div class="art art-5"></div></div>
          <div class="local__thumb local__thumb--b float float--d2 only-desktop"><div class="art art-3"></div></div>
        </div>
      </article>

      <article class="local__card local__lang reveal">
        <span class="only-desktop"><Icon name="globe" size={30} /></span>
        <p class="cycler" data-cycler data-interval="1800" data-words={JSON.stringify(words)} aria-hidden="true"><span class="cycler__word">{words[0]}</span></p>
        <h3 class="local__h3 local__h3--lang">{d.local.language.title}</h3>
        <p class="local__text local__text--lang">{d.local.language.text}</p>
        <ul aria-label={d.local.language.listLabel} class="local__chips">
          {LOCALES.map((l) => (
            <li class:list={['chip', 'local__chip', { 'is-current': l === locale }]} lang={l}>{LOCALE_META[l].label}</li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .local { background: var(--bg); padding-top: 0; }

  .local__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }

  .local__card { min-height: 412px; padding: 44px; border-radius: var(--r-card-lg); }

  .local__h3 { margin: 28px 0 16px; font: 400 32px/1.15 var(--font-serif); }
  .local__text { max-width: 420px; font-size: 16px; line-height: 1.6; color: var(--subtle); }

  /* Card 1: nearby artists */
  .local__nearby {
    position: relative; overflow: hidden;
    background: var(--surface); border: 1px solid var(--divider);
  }
  .local__nearby :global(.icon) { color: var(--accent-text); }
  .local__thumb { position: absolute; }
  .local__thumb .art {
    width: 100%; height: 100%; border: 5px solid #fff;
    box-shadow: 0 6px 14px rgba(27, 37, 48, .08);
  }
  .local__thumb--a { right: 70px; bottom: -14px; width: 110px; height: 80px; }
  .local__thumb--a .art { transform: rotate(-6deg); }
  .local__thumb--b { right: -10px; bottom: -6px; width: 80px; height: 90px; }
  .local__thumb--b .art { transform: rotate(4deg); }

  /* Card 2: language */
  .local__lang { background: var(--ink); color: var(--bg); }
  .local__lang :global(.icon) { display: block; color: var(--accent-soft); }
  .cycler {
    height: 70px; margin: 24px 0 -8px; padding-bottom: 8px; overflow: hidden;
    font: italic 400 56px/1.1 var(--font-serif); color: var(--accent-soft);
  }
  .cycler__word { display: inline-block; }
  .cycler__word.is-in { animation: word-up 500ms var(--ease-out); }
  .local__h3--lang { margin: 4px 0 0; }
  .local__text--lang { max-width: 500px; margin: 14px 0 24px; color: var(--on-dark-muted); }
  .local__chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
  .local__chip { background: var(--ink-soft); color: var(--bg); }
  .local__chip.is-current { background: var(--accent-soft); color: var(--ink); }

  @media (max-width: 1199px) {
    .local__grid { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  }

  @media (max-width: 767px) {
    .local__grid { grid-template-columns: 1fr; gap: 16px; }
    .local__card { min-height: 0; padding: 32px 24px; border-radius: 28px; }
    .local__h3 { margin: 24px 0 14px; font-size: 28px; }
    .local__nearby .local__text { max-width: calc(100% - 56px); }
    .local__thumb--a { right: -12px; bottom: -14px; width: 84px; height: 96px; }
    .local__thumb--a .art { transform: rotate(-6deg); }
    .cycler { height: 74px; margin-top: 0; font-size: 60px; }
    .local__h3--lang { margin: 4px 0 0; }
  }
</style>
