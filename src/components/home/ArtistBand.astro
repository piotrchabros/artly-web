---
// "Dla artystów" band (spec §6.7).
import Icon from '../ui/Icon.astro';
import { useT, type Locale } from '../../i18n';
import { shopHref } from '../../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="wrap band-wrap rv" id="dla-artystow">
  <div class="band">
    <div>
      <h2 class="band__h" data-tid="h2.jestes-artysta">{t('artistBand.title')}</h2>
      <p class="band__p"><span class="only-d">{t('artistBand.text')}</span><span class="only-m">{t('artistBand.textShort')}</span></p>
    </div>
    <a href={shopHref(locale, 'join')} class="btn band__cta" data-tid="a.dolacz-do-artly">{t('artistBand.cta')}<Icon name="arrow" size={18} class="arrow" /></a>
  </div>
</section>

<style>
  .band-wrap { padding-top: 112px; }
  .band { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; padding: 56px 64px; background: var(--c-beige); }
  .band__h { font: 400 40px/1.1 var(--f-display); }
  .band__p { margin-top: 14px; max-width: 620px; font: 400 17px/1.6 var(--f-ui); color: var(--c-text-2); }
  .band__cta { letter-spacing: 0; }
  @media (max-width: 1023px) {
    .band-wrap { padding-top: 56px; }
    .band { display: block; padding: 32px 24px; }
    .band__h { font-size: 30px; }
    .band__p { margin-top: 12px; font-size: 15px; }
    .band__cta { margin-top: 22px; width: 100%; height: 52px; }
    .band__cta :global(.arrow) { display: none; }
  }
</style>
