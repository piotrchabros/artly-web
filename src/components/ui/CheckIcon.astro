---
interface Props {
  size?: number;
  style?: string;
}

const { size = 16, style } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="#9E522A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style={style}><path d="M5 12l5 5 9-10"></path></svg>
