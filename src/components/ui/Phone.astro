---
interface Props {
  src: string;
  alt: string;
  width: number;
  class?: string;
  style?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, width, class: className, style, loading } = Astro.props;
---

<div class:list={['phone', className]} style={`width: ${width}px;${style ? ' ' + style : ''}`}>
  <img src={src} alt={alt} loading={loading ?? 'lazy'} decoding="async">
</div>
