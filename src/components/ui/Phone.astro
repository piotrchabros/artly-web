---
import { Image } from 'astro:assets';
import type { Shot } from '../../data/screens';

interface Props {
  /** outer width in px at >=768 */
  width: number;
  /** outer width in px below 768 (default = width) */
  mobileWidth?: number;
  shot?: Shot;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
  widths?: number[];
  sizes?: string;
  class?: string;
}

const {
  width,
  mobileWidth = width,
  shot,
  priority = false,
  loading = priority ? 'eager' : 'lazy',
  widths = [280, 560],
  class: className,
} = Astro.props;

// screen width = outer width minus the bezel (9px each side, 7px below 768)
const sizes = Astro.props.sizes
  ?? (mobileWidth === width ? `${width - 18}px` : `(max-width: 767px) ${mobileWidth - 14}px, ${width - 18}px`);
---

<div class:list={['phone', className]} style={`--w: ${width}px; --w-m: ${mobileWidth}px`}>
  <div class="phone__screen">
    {shot ? (
      <Image
        src={shot.src}
        alt={shot.alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding="async"
        fetchpriority={priority ? 'high' : undefined}
        class="phone__img"
      />
    ) : <slot />}
  </div>
</div>

<style>
  .phone {
    width: var(--w);
    max-width: 100%;
    border: 9px solid var(--ink);
    border-radius: var(--r-phone);
    background: var(--ink);
    box-shadow: var(--shadow-phone);
    overflow: hidden;
  }
  .phone__screen {
    position: relative;
    aspect-ratio: 390 / 844;
    overflow: hidden;
    border-radius: calc(var(--r-phone) - 9px);
    background: var(--bg);
  }
  .phone__screen :global(.phone__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  @media (max-width: 767px) {
    .phone { width: var(--w-m); border-width: 7px; border-radius: 36px; }
    .phone__screen { border-radius: 29px; }
  }
</style>
