---
type IconName = 'check' | 'download' | 'pin' | 'globe' | 'shield' | 'box' | 'return' | 'card' | 'plus' | 'close' | 'arrow-right';

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, stroke = 1.6, class: className, label } = Astro.props;

const paths: Record<IconName, string> = {
  check: '<path d="M5 12l5 5 9-10"/>',
  download: '<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  shield: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
  box: '<path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4M12 11v10"/>',
  return: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>',
  card: '<rect x="2" y="6" width="20" height="13" rx="2"/><path d="M2 10h20"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
};

const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...a11y}
><Fragment set:html={paths[name]} /></svg>
