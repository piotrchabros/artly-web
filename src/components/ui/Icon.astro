---
/** Line icons, 1.5 px stroke, currentColor (brief: line icons only, in the text colour). */
export type IconName =
  | 'search' | 'bookmark' | 'bag' | 'user' | 'menu' | 'close' | 'arrow' | 'heart' | 'camera'
  | 'image' | 'sparkle' | 'shield' | 'chevron';

interface Props { name: IconName; size?: number; stroke?: number; class?: string; label?: string }
const { name, size = 20, stroke = 1.5, class: className, label } = Astro.props;

const paths: Record<IconName, string> = {
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>',
  bookmark: '<path d="M6 3.5h12v17l-6-4.5-6 4.5z"/>',
  bag: '<path d="M5 8h14l-1 12.5H6z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>',
  user: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M6.5 18.5c1.3-2.2 3.2-3.3 5.5-3.3s4.2 1.1 5.5 3.3"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  arrow: '<path d="M4 12h16M14 6l6 6-6 6"/>',
  heart: '<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/>',
  camera: '<path d="M3.5 8h4l1.5-2.5h6L16.5 8h4v11h-17z"/><circle cx="12" cy="13" r="3.5"/>',
  image: '<rect x="4" y="4" width="16" height="16"/><path d="M4 16l5-5 4 4 2-2 5 5"/><circle cx="15.5" cy="8.5" r="1.3"/>',
  sparkle: '<path d="M12 4l1.6 5.4L19 11l-5.4 1.6L12 18l-1.6-5.4L5 11l5.4-1.6z"/><path d="M18.5 3.5v3M17 5h3"/>',
  shield: '<path d="M12 3l7.5 3v6c0 4.4-3.1 7.6-7.5 9-4.4-1.4-7.5-4.6-7.5-9V6z"/><path d="M9 12l2.2 2.2L15.5 10"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
};
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg class:list={['icon', className]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" focusable="false" {...a11y}><Fragment set:html={paths[name]} /></svg>
