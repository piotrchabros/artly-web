---
import { getDict, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
---

<section id="faq" class="section faq" aria-labelledby="faq-title">
  <div class="container faq__inner">
    <h2 id="faq-title" class="h2 faq__title reveal">{d.faq.title}</h2>
    <div class="faq__list" data-stagger>
      {d.faq.items.map((item) => (
        <details class="faq__item reveal">
          <summary>
            <span>{item.q}</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding-block: 104px; }
  .faq__inner { max-width: calc(820px + 2 * var(--gutter)); }
  .faq__title { text-align: center; margin-bottom: 40px; }

  .faq__item { border-top: 1px solid var(--border-soft); }
  .faq__item:last-child { border-bottom: 1px solid var(--border-soft); }

  .faq__item summary {
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 28px 0; font: 400 22px/1.3 var(--font-serif); color: var(--ink);
    cursor: pointer; list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }

  /* CSS plus: two 1.5px x 16px bars */
  .plus { position: relative; flex: none; width: 20px; height: 20px; color: var(--accent-text); }
  .plus::before, .plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 16px; height: 1.5px; margin: -0.75px 0 0 -8px; background: currentColor; }
  .plus::after { transform: rotate(90deg); }

  .faq__a p { font-size: 16px; line-height: 1.6; color: var(--subtle); padding-bottom: 26px; max-width: 680px; }

  /* A19 + spec 7.7: smooth height, rotating plus, answer fade-up */
  details { interpolate-size: allow-keywords; }
  details::details-content { block-size: 0; overflow: hidden; transition: block-size 350ms var(--ease-out), content-visibility 350ms allow-discrete; }
  details[open]::details-content { block-size: auto; }
  details .plus { transition: transform 300ms ease; }
  details[open] .plus { transform: rotate(45deg); }
  details[open] .faq__a { animation: faq-in 400ms var(--ease-out); }
  @keyframes faq-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    details::details-content { transition: none; }
    details[open] .faq__a { animation: none; }
  }

  @media (max-width: 767px) {
    .faq { padding-block: 56px; }
    .faq__title { text-align: left; margin-bottom: 28px; }
    .faq__item summary { padding: 30px 0; font-size: 19px; line-height: 1.35; }
  }
</style>
