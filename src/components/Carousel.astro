---
import { useT, type Locale } from '../i18n';

interface Props {
  id: string;
  locale: Locale;
  count: number;
  item?: string;
  gap?: string;
  pad?: string;
  align?: 'center' | 'start' | 'none';
  scale?: boolean;
  dark?: boolean;
  dots?: boolean;
  /** adds data-stagger so direct .reveal children get a staggered --stagger delay */
  stagger?: boolean;
  /** aria-label of the list */
  label: string;
  class?: string;
  as?: 'ul' | 'div';
}

const {
  id,
  locale,
  count,
  item = '220px',
  gap = '16px',
  pad = '85px',
  align = 'center',
  scale = false,
  dark = false,
  dots = true,
  stagger = false,
  label,
  class: className,
  as: Tag = 'ul',
} = Astro.props;

const t = useT(locale);
---

<Tag
  id={id}
  class:list={['carousel', className]}
  data-carousel
  data-scale={scale || undefined}
  data-stagger={stagger || undefined}
  style={`--item: ${item}; --gap: ${gap}; --pad: ${pad}; --align: ${align}`}
  role={Tag === 'div' ? 'group' : undefined}
  aria-label={label}
><slot /></Tag>
{dots && count > 1 && (
  <div class:list={['dots', 'carousel-dots', { 'dots--dark': dark }]} data-dots={id}>
    {Array.from({ length: count }, (_, i) => (
      <button type="button" aria-label={t('a11y.slide', { n: i + 1, total: count })} aria-current={i === 0 ? 'true' : undefined}></button>
    ))}
  </div>
)}

<style is:global>
  /* zero-specificity list reset, so the parent's class can lay the track out at >=768 */
  :where(.carousel) { margin: 0; padding: 0; list-style: none; }
  @media (max-width: 767px) {
    .carousel {
      display: flex;
      gap: var(--gap, 16px);
      padding-inline: var(--pad, 85px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--pad, 85px);
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .carousel::-webkit-scrollbar { display: none; }
    .carousel > * {
      flex: 0 0 var(--item, 220px);
      scroll-snap-align: var(--align, center);
      transition: transform 400ms var(--ease-out), opacity 400ms ease;
    }
    .carousel[data-scale][data-ready] > :not(.is-active) { transform: scale(.9); opacity: .55; }
  }
  @media (min-width: 768px) {
    .dots.carousel-dots { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel[data-scale][data-ready] > :not(.is-active) { transform: none; opacity: 1; }
  }
</style>
