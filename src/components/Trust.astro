---
import { getDict, type Locale } from '../i18n';
import Icon from './ui/Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);

const icons = ['shield', 'box', 'return', 'card'] as const;
---

<section id="gwarancje" class="trust" aria-label={d.trust.label}>
  <div class="container">
    <ul class="trust__list" data-stagger>
      {d.trust.items.map((item, i) => (
        <li class="trust__item reveal">
          <span class="trust__icon"><Icon name={icons[i]} size={26} /></span>
          <div>
            <h3 class="trust__title">{item.title}</h3>
            <p class="trust__text">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust { background: var(--bg); padding-block: 80px; border-bottom: 1px solid var(--divider); }
  .trust__list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .trust__item { display: flex; gap: 16px; }
  .trust__icon { flex: none; color: var(--accent-text); line-height: 0; }
  .trust__title { font: 600 17px/1.35 var(--font-sans); color: var(--ink); }
  .trust__text { font-size: 14px; line-height: 1.5; color: var(--subtle); margin-top: 4px; }

  @media (max-width: 1199px) {
    .trust__list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767px) {
    .trust { padding-block: 48px 56px; }
    .trust__list { gap: 32px 16px; }
    .trust__item { flex-direction: column; gap: 0; }
    .trust__icon :global(svg) { width: 34px; height: 34px; }
    .trust__title { font-weight: 500; font-size: 20px; line-height: 1.25; margin-top: 22px; }
    .trust__text { display: none; }
  }
</style>
