---
import { getDict, useT, type Locale } from '../i18n';
import { artworks } from '../data/artworks';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
const t = useT(locale);

// The list is rendered twice so translateX(-50%) loops seamlessly; the copy is hidden from AT.
const tiles = [...artworks.map((a) => ({ ...a, copy: false })), ...artworks.map((a) => ({ ...a, copy: true }))];
---

<section id="nowo-dodane" class="marquee" aria-labelledby="nowo-dodane-title">
  <div class="container marquee__head">
    <h2 id="nowo-dodane-title" class="overline">{d.marquee.title}</h2>
    <span class="marquee__hint only-desktop">{d.marquee.hint}</span>
  </div>
  <div class="marquee__viewport">
    <ul class="marquee__track" aria-label={t('a11y.artworks')}>
      {tiles.map((a) => (
        <li class="tile" aria-hidden={a.copy ? 'true' : undefined}>
          <div class="tile__mat">
            <div class={`tile__art art art-${a.art}`}></div>
          </div>
          <p class="tile__title">{a.title}</p>
          <p class="tile__artist">{a.artist}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marquee { background: var(--surface); border-bottom: 1px solid var(--divider); padding: 36px 0 40px; }
  .marquee__head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 24px; }
  .marquee__hint { font: 400 13px var(--font-sans); color: var(--subtle); }

  .marquee__viewport { overflow: hidden; }
  /* padding-right equals the gap so -50% lands exactly on the start of the copy */
  .marquee__track { list-style: none; margin: 0; padding: 0 20px 0 0; }

  .tile { flex: none; width: 180px; }
  .tile__mat {
    display: grid; place-items: center; width: 180px; height: 200px;
    background: var(--mat); border-radius: 20px;
    transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out);
  }
  .tile__art { width: 136px; height: 156px; border: 4px solid #fff; box-shadow: 0 6px 14px rgba(27,37,48,.08); }
  .tile__title { margin-top: 12px; font: 400 18px/1.25 var(--font-serif); color: var(--ink); }
  .tile__artist { font: 400 13px/1.35 var(--font-sans); color: var(--subtle); }

  @media (hover: hover) {
    .tile:hover .tile__mat { transform: translateY(-8px) rotate(-1deg); box-shadow: var(--shadow-card-hover); }
  }
  /* motion.css pauses on any :hover; keep the track running on touch devices (sticky :hover after a tap) */
  @media (hover: none) {
    .marquee:hover .marquee__track { animation-play-state: running; }
  }

  @media (max-width: 767px) {
    .marquee { padding: 32px 0 36px; }
    .marquee__track { gap: 16px; padding-right: 16px; }
    .tile { width: 128px; }
    .tile__mat { width: 128px; height: 150px; border-radius: 16px; }
    .tile__art { width: 96px; height: 114px; border-width: 3px; }
    .tile__title { margin-top: 16px; font-size: 16px; }
    .tile__artist { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__viewport { overflow-x: auto; }
    .tile:hover .tile__mat { transform: none; }
  }
</style>
