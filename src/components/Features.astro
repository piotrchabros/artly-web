---
import Phone from './ui/Phone.astro';
import CheckIcon from './ui/CheckIcon.astro';

const discoverBullets = [
  { bold: 'Dla Ciebie', text: ' — rekomendacje na podstawie preferencji i zdjęcia wnętrza' },
  { bold: 'Według stylu i barwy', text: ' — od abstrakcji po pejzaż, od ciepłych ziem po błękity' },
  { bold: 'Kolekcje kuratorów', text: ' — „Nad sofę”, „Spokojna sypialnia”, „Do 1 000 zł”, „Ściana galerii”' },
  { bold: 'Nowości i popularne', text: ' — co właśnie dodali artyści i co zapisują inni' },
];

const wallBullets = [
  'Zmieniaj rozmiar i ramę — cena przelicza się od razu',
  'Porównuj kilka prac na tej samej ścianie i widok „przed / po”',
  '„Dlaczego pasuje” — jasne powody dopasowania przy każdym dziele',
  'Udostępnij wizualizację domownikom, zanim podejmiesz decyzję',
];

const customBullets = [
  'Wycena i szkic od artysty, zanim cokolwiek zapłacisz',
  'Kolory i format dobrane dokładnie do Twojej ściany',
  'Rozmowa z artystą i statusy realizacji w jednym miejscu',
];

const tasteBullets = [
  'Powiadomienia o nowych pracach w Twoim guście',
  'Kilka wnętrz w jednym koncie — salon, sypialnia, biuro',
  'Ulubione i obserwowani artyści zawsze pod ręką',
];

const checkStyle = 'flex-shrink: 0; margin-top: 3px';
---

<section id="funkcje" style="background: #FFFFFF; padding: 104px 24px">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 112px">
    <div style="text-align: center">
      <div style="font-size: 12px; letter-spacing: 0.24em; font-weight: 600; color: #9E522A">FUNKCJE</div>
      <h2 style="margin: 14px 0 0; font-family: 'Newsreader', serif; font-weight: 400; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.1">Wszystko, czego potrzebujesz, by znaleźć „to” dzieło</h2>
    </div>

    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 64px">
      <div style="flex: 1 1 340px; display: flex; justify-content: center"><div style="padding: 48px 56px; border-radius: 28px; background: #EAF1F4"><Phone src="/assets/66c13928dde448201100f3f7bd18ea1b.png" alt="Ekran Odkrywaj: style, banery, rekomendacje Dla Ciebie" width={270} /></div></div>
      <div style="flex: 1 1 420px; min-width: 0">
        <h3 style="margin: 0 0 16px; font-family: 'Newsreader', serif; font-weight: 400; font-size: 38px; line-height: 1.1">Odkrywaj sztukę, która do Ciebie pasuje</h3>
        <p style="margin: 0 0 24px; font-size: 17px; line-height: 1.6; color: #4A5560">Ekran Odkrywaj to codzienna dawka sztuki ułożona wokół Twojego gustu i Twojego wnętrza.</p>
        <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.5">
          {discoverBullets.map((item) => (
            <li style="display: flex; gap: 12px"><CheckIcon size={18} style={checkStyle} /><span><b style="font-weight: 600">{item.bold}</b>{item.text}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div style="display: flex; flex-wrap: wrap-reverse; align-items: center; gap: 64px">
      <div style="flex: 1 1 420px; min-width: 0">
        <h3 style="margin: 0 0 16px; font-family: 'Newsreader', serif; font-weight: 400; font-size: 38px; line-height: 1.1">Zobacz obraz na swojej ścianie</h3>
        <p style="margin: 0 0 24px; font-size: 17px; line-height: 1.6; color: #4A5560">Koniec z zastanawianiem się, czy obraz nie będzie za mały. ARTLY rozpoznaje ścianę na zdjęciu i pokazuje dzieło w jego prawdziwej skali.</p>
        <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.5">
          {wallBullets.map((text) => (
            <li style="display: flex; gap: 12px"><CheckIcon size={18} style={checkStyle} /><span>{text}</span></li>
          ))}
        </ul>
      </div>
      <div style="flex: 1 1 340px; display: flex; justify-content: center; gap: 20px">
        <div style="padding: 48px 40px; border-radius: 28px; background: #F0E9E0; display: flex; gap: 20px; align-items: flex-start">
          <Phone src="/assets/33a48acf66d17e9c2186e7562ad52738.png" alt="Wizualizacja z wyborem rozmiaru i ramy" width={230} />
          <Phone class="hide-sm" src="/assets/59e8b5e864c6d72e97a41ab182612192.png" alt="Karta dzieła z sekcją Dlaczego pasuje" width={200} style="margin-top: 60px" />
        </div>
      </div>
    </div>

    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 64px">
      <div style="flex: 1 1 340px; display: flex; justify-content: center"><div style="padding: 48px 56px; border-radius: 28px; background: #EAF1F4"><Phone src="/assets/755527ca3fdd3c5eddf9dce1887a6d52.png" alt="Formularz zamówienia dzieła na wymiar" width={270} /></div></div>
      <div style="flex: 1 1 420px; min-width: 0">
        <h3 style="margin: 0 0 16px; font-family: 'Newsreader', serif; font-weight: 400; font-size: 38px; line-height: 1.1">Zamów dzieło na wymiar</h3>
        <p style="margin: 0 0 24px; font-size: 17px; line-height: 1.6; color: #4A5560">Nie znalazłeś idealnego? Opisz, czego szukasz, wybierz wymiary, budżet i termin. Artysta dostaje Twój opis razem ze zdjęciem wnętrza.</p>
        <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.5">
          {customBullets.map((text) => (
            <li style="display: flex; gap: 12px"><CheckIcon size={18} style={checkStyle} /><span>{text}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div style="display: flex; flex-wrap: wrap-reverse; align-items: center; gap: 64px">
      <div style="flex: 1 1 420px; min-width: 0">
        <h3 style="margin: 0 0 16px; font-family: 'Newsreader', serif; font-weight: 400; font-size: 38px; line-height: 1.1">Aplikacja, która uczy się Twojego gustu</h3>
        <p style="margin: 0 0 24px; font-size: 17px; line-height: 1.6; color: #4A5560">W profilu ustawiasz ulubione style, barwy i motywy — od jeziora po martwą naturę. Zapisujesz swoje wnętrza i obserwujesz artystów.</p>
        <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.5">
          {tasteBullets.map((text) => (
            <li style="display: flex; gap: 12px"><CheckIcon size={18} style={checkStyle} /><span>{text}</span></li>
          ))}
        </ul>
      </div>
      <div style="flex: 1 1 340px; display: flex; justify-content: center"><div style="padding: 48px 56px; border-radius: 28px; background: #F0E9E0"><Phone src="/assets/f62bd8bd51d7c1b42d8b9cb03bdc93ca.png" alt="Profil z preferencjami: style, barwy, motywy" width={270} /></div></div>
    </div>
  </div>
</section>
