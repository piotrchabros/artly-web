---
import { getDict, type Locale } from '../i18n';
import { shot, type ScreenKey } from '../data/screens';
import ScreenRotator from './ScreenRotator.astro';
import Icon from './ui/Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);

const keys: ScreenKey[] = ['odkrywaj', 'wizualizacja', 'zamowienie', 'profil'];
const shots = keys.map((k) => shot(k, d.screens[k]));
---

<section id="funkcje" class="section ftabs" data-tabs aria-labelledby="ftabs-title">
  <div class="container">
    <div class="ftabs__head reveal">
      <p class="overline">{d.features.overline}</p>
      <h2 id="ftabs-title" class="h2 ftabs__title">{d.features.title}</h2>
    </div>

    <div class="ftabs__nav">
      <div role="tablist" aria-label={d.features.tabsLabel} class="ftabs__list">
        {d.features.tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`ft-tab-${i}`}
            aria-controls={`ft-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="ftab"
          >{tab.tab}</button>
        ))}
      </div>
    </div>

    <div class="ftabs__body">
      <div class="ftabs__card">
        <ScreenRotator
          id="features-rotator"
          width={308}
          mobileWidth={244}
          autoplay={false}
          dots={false}
          shots={shots}
          widths={[300, 600]}
          sizes="(max-width: 767px) 230px, 290px"
          label={d.features.tabsLabel}
        />
      </div>

      <div class="ftabs__panels">
        {d.features.tabs.map((tab, i) => (
          <div
            role="tabpanel"
            id={`ft-panel-${i}`}
            aria-labelledby={`ft-tab-${i}`}
            tabindex="0"
            class="ftabs__panel"
            hidden={i > 0}
          >
            <h3 class="ftabs__h3">{tab.title}</h3>
            <p class="text ftabs__text">{tab.text}</p>
            <ul class="checklist ftabs__checks">
              {tab.bullets.map((b) => (
                <li><Icon name="check" size={18} /><span>{b}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ftabs { background: var(--bg); }

  .ftabs__head { max-width: 760px; margin-inline: auto; text-align: center; }
  .ftabs__title { margin-top: 14px; }

  .ftabs__nav { margin-top: 40px; text-align: center; }
  .ftabs__list {
    display: inline-flex; gap: 4px; padding: 6px;
    background: var(--sand); border-radius: var(--r-pill);
  }
  .ftab {
    height: 46px; padding: 0 22px; border: 0; border-radius: var(--r-pill);
    background: transparent; color: var(--subtle);
    font: 400 15px var(--font-sans); white-space: nowrap; cursor: pointer;
    transition: background 300ms var(--ease-out), color 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
  }
  .ftab[aria-selected='true'] {
    background: var(--ink); color: var(--bg);
    box-shadow: 0 8px 18px rgba(27, 37, 48, .18);
  }

  .ftabs__body {
    display: grid; grid-template-columns: 436px 1fr; gap: 112px; align-items: center;
    margin-top: 56px; padding-left: 40px;
  }
  .ftabs__card {
    display: flex; justify-content: center;
    padding: 52px 0; border-radius: var(--r-card-lg);
    background: linear-gradient(180deg, #F1E8DD, #EFE6DA);
  }

  .ftabs__panel:focus-visible { outline-offset: 8px; }
  .ftabs__h3 { font: 400 42px/1.1 var(--font-serif); }
  .ftabs__text { margin: 18px 0 28px; font-size: 17px; }
  .ftabs__checks { font-size: 15.5px; line-height: 1.5; color: var(--ink); }

  @media (max-width: 1199px) {
    .ftabs__body { grid-template-columns: 1fr; gap: 48px; padding-left: 0; justify-items: center; }
    .ftabs__card { width: 100%; max-width: 436px; }
    .ftabs__panels { max-width: 640px; }
  }

  @media (max-width: 767px) {
    .ftabs__head { text-align: left; }

    .ftabs__nav { margin-top: 28px; text-align: left; }
    .ftabs__list {
      display: flex; gap: 8px; padding: 4px var(--gutter);
      margin-inline: calc(-1 * var(--gutter));
      overflow-x: auto; scrollbar-width: none;
      background: none; border-radius: 0;
    }
    .ftabs__list::-webkit-scrollbar { display: none; }
    .ftab {
      flex: none; height: 54px; padding: 0 26px;
      border: 1px solid var(--border); color: var(--ink); font-size: 17px;
    }
    .ftab[aria-selected='true'] { border-color: var(--ink); box-shadow: none; }

    .ftabs__body { margin-top: 28px; gap: 32px; justify-items: stretch; }
    .ftabs__card { max-width: none; padding: 40px 0; }
    .ftabs__h3 { font-size: 30px; line-height: 1.12; }
    .ftabs__text { font-size: 16px; }
    .ftabs__checks { font-size: 17px; }
  }
</style>
