---
import Logo from './ui/Logo.astro';
import { localePath, useT, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);

const links = [
  { label: t('footer.artists'), href: localePath(locale, '', 'dla-artystow') },
  { label: t('footer.faq'), href: localePath(locale, '', 'faq') },
  { label: t('footer.terms'), href: localePath(locale, 'regulamin') },
  { label: t('footer.privacy'), href: localePath(locale, 'polityka-prywatnosci') },
  { label: t('footer.contact'), href: localePath(locale, 'kontakt') },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo size={22} href={localePath(locale)} label={t('a11y.home')} />
      <span class="footer__tagline">{t('footer.tagline')}</span>
    </div>
    <nav class="footer__nav" aria-label={t('footer.label')}>
      {links.map((l) => <a class="footer__link" href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--divider); padding: 40px 0; }
  .footer__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px 40px; flex-wrap: wrap; }
  .footer__brand { display: flex; align-items: center; gap: 18px; }
  .footer__tagline { font-size: 14px; color: var(--subtle); }
  .footer__nav { display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .footer__link { font-size: 14px; color: var(--subtle); text-decoration: none; }
  @media (hover: hover) { .footer__link:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; } }

  @media (max-width: 767px) {
    .footer { padding: 40px 0 calc(96px + env(safe-area-inset-bottom)); }
    .footer__inner { flex-direction: column; align-items: stretch; gap: 28px; }
    .footer__tagline { font-size: 14px; }
    .footer__nav { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
    .footer__link {
      display: flex; align-items: center; min-height: 44px; font-size: 16px;
      text-decoration: underline; text-underline-offset: 3px;
    }
  }
</style>
