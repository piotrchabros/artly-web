---
const guarantees = [
  {
    icon: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path><path d="M9 12l2 2 4-4"></path>',
    title: 'Certyfikat autentyczności',
    text: 'Do każdego oryginału.',
  },
  {
    icon: '<path d="M3 7l9-4 9 4v10l-9 4-9-4z"></path><path d="M3 7l9 4 9-4M12 11v10"></path>',
    title: 'Dostawa z ubezpieczeniem',
    text: 'Artystyczne pakowanie i śledzenie przesyłki.',
  },
  {
    icon: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path>',
    title: '14 dni na zwrot',
    text: 'Dla gotowych prac kupionych w aplikacji.',
  },
  {
    icon: '<rect x="2" y="6" width="20" height="13" rx="2"></rect><path d="M2 10h20"></path>',
    title: 'Bezpieczne płatności',
    text: 'BLIK, karta lub przelew.',
  },
];
---

<section style="padding: 72px 24px; border-bottom: 1px solid #ECE5DB">
  <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px">
    {guarantees.map((item) => (
      <div style="display: flex; gap: 16px; align-items: flex-start">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#9E522A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0"><Fragment set:html={item.icon} /></svg>
        <div><div style="font-size: 17px; font-weight: 600">{item.title}</div><div style="margin-top: 4px; font-size: 14px; line-height: 1.5; color: #4A5560">{item.text}</div></div>
      </div>
    ))}
  </div>
</section>
