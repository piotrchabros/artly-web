---
// /aplikacja: app download page, target of /app for desktop visitors. Empty-state pattern: title, one sentence, buttons.
import Base from '../../layouts/Base.astro';
import { useT, type Locale } from '../../i18n';
import { APP_STORE_URL, PLAY_URL } from '../../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
---

<Base locale={locale} page="app" title={`${t('appPage.metaTitle')} | ARTLY`} description={t('appPage.text')}>
  <section class="wrap app">
    <img class="app__icon" src="/brand/artly-symbol-white.svg" width="40" height="40" alt="" />
    <h1 class="h1 h1--sm app__h">{t('appPage.title')}</h1>
    <p class="lead app__p">{t('appPage.text')}</p>
    <div class="app__btns">
      {APP_STORE_URL
        ? <a class="btn" href={APP_STORE_URL}>{t('appPage.appStore')}</a>
        : <span class="btn btn--outline app__soon" aria-disabled="true">{t('appPage.soon')}</span>}
      <a class="btn" href={PLAY_URL}>{t('appPage.googlePlay')}</a>
    </div>
  </section>
</Base>

<style>
  .app { max-width: 480px; padding-top: 112px; padding-bottom: 0; text-align: center; }
  .app__icon { box-sizing: content-box; margin: 0 auto; padding: 12px; background: var(--c-ink); border-radius: 14px; }
  .app__h { margin-top: 32px; }
  .app__p { margin-top: 20px; }
  .app__btns { margin-top: 40px; display: flex; flex-direction: column; gap: 12px; }
  .app__soon { color: var(--c-muted); cursor: default; }
  .app__soon:hover { background: transparent; }
  @media (max-width: 1023px) { .app { padding-top: 56px; } }
</style>
