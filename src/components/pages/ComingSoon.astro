---
import Base from '../../layouts/Base.astro';
import { getDict, localePath, type Locale } from '../../i18n';

interface Props { locale: Locale; page: 'kontakt' }
const { locale, page } = Astro.props;
const d = getDict(locale);
const title = d.pages[page].title;
---

<Base locale={locale} page={page} title={`${title} — ARTLY`} description={d.pages.soon.text}>
  <section class="soon">
    <p class="overline">{d.pages.soon.overline}</p>
    <h1 class="h2 soon__title">{title}</h1>
    <p class="lead soon__text">{d.pages.soon.text}</p>
    <a class="btn btn--dark" href={localePath(locale)}>{d.pages.soon.back}</a>
  </section>
</Base>

<style>
  .soon { max-width: 720px; margin-inline: auto; padding: 120px 24px 140px; text-align: center; }
  .soon__title { margin-top: 18px; }
  .soon__text { margin: 20px 0 36px; }
</style>
