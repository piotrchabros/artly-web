---
import { Image } from 'astro:assets';
import Phone from './ui/Phone.astro';
import type { Shot } from '../data/screens';

interface Props {
  id: string;
  shots: Shot[];
  width: number;
  mobileWidth?: number;
  interval?: number;
  dots?: boolean;
  autoplay?: boolean;
  priority?: boolean;
  widths?: number[];
  sizes?: string;
  /** aria-label for the dots tablist */
  label: string;
  class?: string;
}

const {
  id,
  shots,
  width,
  mobileWidth = width,
  interval = 3200,
  dots = true,
  autoplay = true,
  priority = false,
  widths = [280, 560],
  label,
  class: className,
} = Astro.props;

const sizes = Astro.props.sizes
  ?? (mobileWidth === width ? `${width - 18}px` : `(max-width: 767px) ${mobileWidth - 14}px, ${width - 18}px`);
---

<div
  class:list={['rotator', className]}
  id={id}
  data-rotator
  data-interval={interval}
  data-autoplay={autoplay ? 'on' : 'off'}
>
  <Phone width={width} mobileWidth={mobileWidth}>
    {shots.map((s, i) => (
      <Image
        src={s.src}
        alt={s.alt}
        widths={widths}
        sizes={sizes}
        class:list={['shot', { 'is-active': i === 0 }]}
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={i === 0 && priority ? 'high' : undefined}
        aria-hidden={i === 0 ? undefined : 'true'}
      />
    ))}
  </Phone>
  {dots && shots.length > 1 && (
    <div class="dots" role="tablist" aria-label={label}>
      {shots.map((s, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          aria-label={s.alt}
          data-go={i}
        ></button>
      ))}
    </div>
  )}
</div>

<style>
  .rotator { display: flex; flex-direction: column; align-items: center; }
  .rotator :global(.shot) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 700ms ease, transform 900ms var(--ease-out);
  }
  .rotator :global(.shot.is-active) { opacity: 1; transform: scale(1); }
</style>
