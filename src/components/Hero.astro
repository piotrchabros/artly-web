---
import CheckIcon from './ui/CheckIcon.astro';
import Phone from './ui/Phone.astro';

const checks = [
  'Oryginały niezależnych artystów',
  'Wizualizacja na Twojej ścianie',
  'Dzieła na zamówienie',
];
---

<section id="top" style="max-width: 1200px; margin: 0 auto; padding: 40px 24px 96px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px">
  <div style="flex: 1 1 460px; min-width: 0">
    <div style="font-size: 12px; letter-spacing: 0.32em; color: #4A5560">WHERE ART MEETS SPACE</div>
    <h1 style="margin: 18px 0 20px; font-family: 'Newsreader', serif; font-weight: 400; font-size: clamp(42px, 5.4vw, 74px); line-height: 1.02">Sztuka, która naprawdę pasuje do Twojego wnętrza.</h1>
    <p style="margin: 0; max-width: 520px; font-size: 19px; line-height: 1.55; color: #4A5560">ARTLY zaczyna od Twojej przestrzeni, nie od katalogu. Zrób zdjęcie ściany, powiedz, co lubisz — pokażemy prace niezależnych artystów dopasowane do wnętrza, stylu i budżetu. I zobaczysz je u siebie, zanim kupisz.</p>
    <div style="margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px">
      <a href="#pobierz" style="display: inline-flex; align-items: center; gap: 10px; height: 56px; padding: 0 26px; border-radius: 999px; background: #1B2530; color: #F7F4EF; text-decoration: none; font-size: 16px; font-weight: 500">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
        Pobierz na iOS i Androida
      </a>
      <a href="#jak-to-dziala" style="display: inline-flex; align-items: center; height: 56px; padding: 0 26px; border-radius: 999px; border: 1px solid #CFC4B6; text-decoration: none; font-size: 16px; font-weight: 500">Zobacz, jak to działa</a>
    </div>
    <div style="margin-top: 28px; display: flex; flex-wrap: wrap; gap: 20px; font-size: 14px; color: #4A5560">
      {checks.map((label) => (
        <span style="display: inline-flex; align-items: center; gap: 8px"><CheckIcon />{label}</span>
      ))}
    </div>
  </div>
  <div style="flex: 1 1 420px; min-width: 0; position: relative; height: 640px; display: flex; justify-content: center">
    <div aria-hidden="true" style="position: absolute; right: 0; top: 0; width: 300px; height: 600px; border-radius: 150px 150px 0 0; background: linear-gradient(180deg, #DCE8F0 0%, #F0E9E0 100%); border: 12px solid #EFE7DC; box-sizing: border-box"></div>
    <Phone
      src="/assets/66c13928dde448201100f3f7bd18ea1b.png"
      alt="Ekran Odkrywaj w aplikacji ARTLY"
      width={250}
      class="hide-sm"
      style="position: absolute; left: 4%; top: 70px; transform: rotate(-4deg)"
      loading="eager"
    />
    <Phone
      src="/assets/33a48acf66d17e9c2186e7562ad52738.png"
      alt="Wizualizacja obrazu na ścianie salonu w aplikacji ARTLY"
      width={270}
      style="position: relative; margin-left: 18%; top: 10px; height: fit-content"
      loading="eager"
    />
  </div>
</section>
