---
import { getDict, useT, type Locale } from '../i18n';
import { shot } from '../data/screens';
import Icon from './ui/Icon.astro';
import Phone from './ui/Phone.astro';
import ScreenRotator from './ScreenRotator.astro';
import Carousel from './Carousel.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
const t = useT(locale);

const words = d.hero.title.split(' ');
const accentFrom = words.length - d.hero.titleAccentWords;

const keys = ['wizualizacja', 'odkrywaj', 'dzielo', 'profil'] as const;
const shots = keys.map((k) => shot(k, d.screens[k]));
const back = shot('odkrywaj', d.screens.odkrywaj);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="tagline enter" style="--delay:50ms">{d.hero.tagline}</p>
      <h1 id="hero-title" class="h1 hero__title">
        {words.map((w, i) => (
          <Fragment>
            <span class:list={['word', { accent: i >= accentFrom }]} style={`--delay:${100 + 80 * i}ms`}>{w}</span>{i < words.length - 1 ? ' ' : ''}
          </Fragment>
        ))}
      </h1>
      <p class="lead hero__lead enter" style="--delay:700ms">{d.hero.lead}</p>
      <div id="hero-ctas" class="hero__ctas enter" style="--delay:850ms">
        <a class="btn btn--dark" href="#pobierz"><Icon name="download" size={18} />{d.hero.ctaPrimary}</a>
        <a class="btn btn--ghost" href="#jak-to-dziala">{d.hero.ctaSecondary}</a>
      </div>
      <ul class="hero__features only-desktop enter" style="--delay:1000ms">
        {d.hero.features.map((f) => (
          <li><Icon name="check" size={16} />{f}</li>
        ))}
      </ul>
    </div>

    <div class="hero__visual only-desktop enter" style="--delay:300ms">
      <div class="hero__arch" aria-hidden="true"></div>
      <svg class="hero__ribbons" viewBox="0 0 560 640" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path class="ribbon" stroke="var(--accent)" d="M470 352 C 505 332, 560 330, 612 352" />
        <path class="ribbon ribbon--late" stroke="#8FB0C6" d="M478 388 C 515 366, 565 362, 618 378" />
        <path class="ribbon" stroke="var(--accent)" d="M-24 532 C -2 516, 22 506, 60 498" />
        <path class="ribbon ribbon--late" stroke="#8FB0C6" d="M-4 552 C 14 542, 34 536, 60 530" />
      </svg>
      <div class="hero__back">
        <div class="float-tilt">
          <Phone width={250} shot={back} loading="lazy" widths={[240, 480]} sizes="232px" />
        </div>
      </div>
      <div class="hero__front">
        <ScreenRotator
          id="hero-rotator"
          width={296}
          shots={shots}
          priority
          widths={[280, 560]}
          sizes="278px"
          label={t('a11y.screens')}
        />
      </div>
      <div class="hero__card-pos hero__card-pos--wall">
        <div class="float float--d2">
          <div class="hero__card">
            <span class="hero__card-check"><Icon name="check" size={18} /></span>
            <span><strong>{d.hero.cardWall.title}</strong><span>{d.hero.cardWall.detail}</span></span>
          </div>
        </div>
      </div>
      <div class="hero__card-pos hero__card-pos--match">
        <div class="float float--d4">
          <div class="hero__card">
            <span class="hero__swatch" aria-hidden="true"></span>
            <span><strong>{d.hero.cardMatch.title}</strong><span>{d.hero.cardMatch.detail}</span></span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero__mobile only-mobile">
      <div class="hero__arch hero__arch--m" aria-hidden="true"></div>
      <Carousel
        id="hero-carousel"
        locale={locale}
        count={shots.length}
        item="220px"
        gap="16px"
        pad="85px"
        align="center"
        scale
        label={t('a11y.screens')}
        class="hero__carousel"
      >
        {shots.map((s, i) => (
          <li class="hero__slide">
            <Phone width={220} mobileWidth={220} shot={s} loading={i === 0 ? 'eager' : 'lazy'} widths={[220, 440]} sizes="206px" />
            <p class="hero__caption">{d.hero.slides[i]}</p>
          </li>
        ))}
      </Carousel>
      <div class="hero__card-pos hero__card-pos--m">
        <div class="float">
          <div class="hero__card">
            <span class="hero__card-check"><Icon name="check" size={18} /></span>
            <span><strong>{d.hero.cardWall.titleShort}</strong><span>{d.hero.cardWall.detailShort}</span></span>
          </div>
        </div>
      </div>
      <p class="hero__hint">{d.hero.swipeHint}</p>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--bg); border-bottom: 1px solid var(--divider); padding: 72px 0 88px; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 56px; }
  @media (min-width: 1200px) {
    .hero__grid { grid-template-columns: 1fr 560px; gap: 40px; align-items: center; }
  }
  .hero__text { min-width: 0; }
  .hero__title { margin: 18px 0 28px; }
  .hero__lead { max-width: 520px; line-height: 1.6; }

  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .hero__features {
    list-style: none; padding: 0; margin-top: 32px;
    display: flex; flex-wrap: wrap; gap: 14px 24px;
    font: 400 14px/1.4 var(--font-sans); color: var(--subtle);
  }
  .hero__features li { display: inline-flex; align-items: center; gap: 10px; }
  .hero__features li :global(svg) { color: var(--accent-text); flex: none; }

  /* desktop / tablet visual */
  .hero__visual { position: relative; height: 640px; width: 100%; max-width: 560px; margin-inline: auto; }
  .hero__arch {
    position: absolute; right: 0; top: -10px; width: 330px; height: 640px;
    border-radius: 165px 165px 0 0;
    background: linear-gradient(180deg, var(--arch-from), var(--arch-to));
    border: 12px solid var(--arch-border);
  }
  .hero__ribbons { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hero__back { position: absolute; left: 10px; top: 70px; }
  .hero__front { position: absolute; left: 190px; top: 0; }
  .hero__card-pos { position: absolute; z-index: 2; }
  .hero__card-pos--wall { right: -10px; top: 130px; }
  .hero__card-pos--match { left: 120px; bottom: 10px; }

  .hero__card {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 18px; border-radius: 18px;
    background: var(--surface); box-shadow: var(--shadow-chip);
    font: 400 14px/1.35 var(--font-sans); color: var(--subtle); white-space: nowrap;
  }
  .hero__card strong { display: block; font-weight: 600; color: var(--ink); }
  .hero__card-check { display: flex; color: var(--success); }
  .hero__swatch {
    flex: none; width: 32px; height: 32px; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #F2C3A1, #D2885A);
  }

  /* mobile visual */
  .hero__mobile { position: relative; margin-top: 48px; }
  .hero__arch--m { right: auto; left: 50%; top: 20px; width: 280px; height: 520px; margin-left: -140px; border-radius: 140px 140px 0 0; }
  .hero__mobile :global(.hero__carousel) { position: relative; margin-inline: calc(-1 * var(--gutter)); }
  .hero__slide { display: flex; flex-direction: column; align-items: center; }
  .hero__caption { margin-top: 22px; font: 500 17px/1.3 var(--font-sans); color: var(--ink); text-align: center; }
  .hero__card-pos--m { top: 170px; right: 16px; }
  .hero__hint { margin-top: 14px; font: 400 15px/1.4 var(--font-sans); color: var(--subtle); text-align: center; }

  @media (max-width: 767px) {
    .hero { padding: 40px 0 56px; }
    .hero__grid { gap: 0; }
    .hero__ctas { flex-direction: column; }
    .hero__ctas .btn { width: 100%; }
  }
</style>
