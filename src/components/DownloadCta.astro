---
import { getDict, type Locale } from '../i18n';
import Logo from './ui/Logo.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
---

<section id="pobierz" class="section download" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta cta-gradient reveal">
      <div class="cta__copy">
        <div class="cta__logo" aria-hidden="true"><Logo size={46} /></div>
        <h2 id="cta-title" class="h2 cta__title">{d.cta.title}</h2>
        <p class="cta__text">{d.cta.text}</p>
      </div>
      <div class="cta__stores">
        <a class="btn btn--dark" href="#pobierz">{d.cta.appStore}</a>
        <a class="btn btn--dark" href="#pobierz">{d.cta.googlePlay}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .download { padding-block: 104px; }

  .cta {
    border-radius: var(--r-card-lg); padding: 88px 56px;
    display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center;
  }
  .cta__logo { line-height: 1; }
  .cta__title { margin-top: 20px; font-size: 46px; line-height: 1.1; }
  .cta__text { font-size: 17px; line-height: 1.65; color: var(--subtle); max-width: 460px; margin-top: 16px; }

  .cta__stores { display: flex; flex-direction: column; gap: 12px; }
  .cta__stores .btn { width: 250px; height: 58px; }

  @media (max-width: 767px) {
    .download { padding-block: 24px 72px; }
    .cta { border-radius: 28px; padding: 48px 24px 40px; grid-template-columns: 1fr; gap: 32px; }
    /* Logo sets --logo-size inline from its size prop; override it for mobile. */
    .cta__logo :global(.logo) { --logo-size: 40px !important; }
    .cta__title { font-size: 34px; }
    .cta__stores .btn { width: 100%; height: 54px; }
  }
</style>
